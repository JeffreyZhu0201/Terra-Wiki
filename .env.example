# 复制成 .env 后按需修改。docker compose 会自动读同目录的 .env。

# 数据库（compose 里是 db 服务，本地开发指向 docker-compose.test.yml 的库）
DATABASE_URL=postgres://terra:terra@localhost:5432/terra
# 测试库（docker-compose.test.yml 里的 db-test 服务）
TEST_DATABASE_URL=postgres://terra:terra@localhost:55432/terra_test

# 上传目录（compose 里挂卷到 /app/uploads）
UPLOAD_DIR=./public/uploads

# 站点对外地址，用于 RSS 与 sitemap 的绝对链接
SITE_URL=http://localhost:3000

# 首次启动时创建的初始管理员（仅当 users 表为空时生效）
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-to-a-long-password

# 浏览量去重用的盐（访客 id 会先哈希再入库）
VID_SALT=change-me
