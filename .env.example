# 复制成 .env 后按需修改。docker compose 会自动读取同目录的 .env。

# ---- 数据库凭据（compose 里的 db / db-dev 服务都用它）----
# 注意：POSTGRES_PASSWORD 只在数据卷首次初始化时生效，
# 改密码需要同时改 DATABASE_URL 并删除重建数据卷。
POSTGRES_USER=terra
POSTGRES_PASSWORD=change-me
POSTGRES_DB=terra

# next dev / 生产 app 连接的主库
# （生产 compose 内部会自动指向 db 服务，这里改的是本机 dev 用的地址）
DATABASE_URL=postgres://terra:change-me@localhost:5432/terra
# pnpm test 用的测试库（docker-compose.dev.yml 里的 db-test 服务）
TEST_DATABASE_URL=postgres://terra:change-me@localhost:55432/terra_test

# 上传目录（本地 dev 用；生产 compose 固定挂卷到 /app/uploads）
UPLOAD_DIR=./public/uploads

# 站点对外地址，用于 RSS 与 sitemap 的绝对链接
SITE_URL=http://localhost:3000

# 首次启动时创建的初始管理员（仅当 users 表为空时生效）
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-to-a-long-password

# 浏览量去重用的盐（访客 id 会先哈希再入库）
VID_SALT=change-me
