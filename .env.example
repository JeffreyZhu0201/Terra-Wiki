# 开发库（docker compose 里的 db 服务）
DATABASE_URL=postgres://terra:terra@localhost:5432/terra
# 测试库（docker-compose.test.yml 里的 db-test 服务）
TEST_DATABASE_URL=postgres://terra:terra@localhost:55432/terra_test
# 会话签名密钥，换成长随机串
SESSION_SECRET=change-me-to-a-long-random-string
# 上传目录（compose 里挂卷到 /app/uploads）
UPLOAD_DIR=./public/uploads
# 站点对外地址，用于 RSS 与 sitemap 的绝对链接
SITE_URL=http://localhost:3000
# 首次启动时创建的初始管理员（仅当 users 表为空时生效）
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me
# 浏览量去重用的盐（vid 会先哈希再入库）
VID_SALT=change-me
# MCP token 哈希用的盐
MCP_TOKEN_SALT=change-me
